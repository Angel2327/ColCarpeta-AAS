S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=documentos

# Operador
OPERATOR_ID=6aaeb415b765590002607402
OPERATOR_NAME=ColCarpeta
GOVCARPETA_URL=https://govcarpeta-apis-4905ff3c005b.herokuapp.com
PUBLIC_BASE_URL=https://colcarpeta.up.railway.app
DOMINIO_CARPETA=carpetacolombia.co

# Sesion (JWT RS256; llaves PEM con \n literal dentro del valor, ver docs/especificacion.md)
