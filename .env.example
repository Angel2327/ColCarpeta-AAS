# Base de datos (Supabase -> Project Settings -> Database -> Connection string -> Session pooler)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Almacenamiento (Supabase -> Project Settings -> Storage -> S3 Access Keys)
